# Generate with: openssl rand -hex 32
JWT_SECRET=
# Required only when creating the initial admin account (12–72 bytes).
INITIAL_ADMIN_PASSWORD=

# API and local data locations (relative paths are resolved from the repository root).
API_HOST=0.0.0.0
API_PORT=3000
APP_DATA_DIR=data
SQLITE_PATH=data/app.sqlite3
UPLOAD_DIR=data/raw_pdfs
LANCEDB_PATH=data/vector_db
KNOWLEDGE_MAP_CACHE_DIR=data/knowledge_maps
PYTHON_EXECUTABLE=venv/bin/python3

# Child-process and model-server settings.
QA_PROCESS_TIMEOUT_MS=60000
VECTORIZE_TIMEOUT_MS=900000
LLAMA_API_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_REQUEST_TIMEOUT_SECONDS=180
LLAMA_SERVER_BIN=3rdparty/llama.cpp/build/bin/llama-server
LLAMA_MODEL_PATH=data/models/gemma-2-2b-it-q4_k_m.gguf
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_GPU_LAYERS=99
# Optional; uncomment and set to a llama.cpp-supported device name if needed.
# LLAMA_DEVICE=CUDA0
FRONTEND_PORT=3001
