{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "format": "prettier --write \"../backend/**/*.js\" \"src/**/*.{js,css}\" \"../backend/package.json\" \"package.json\" \"../.prettierrc.json\"",
    "format:check": "prettier --check \"../backend/**/*.js\" \"src/**/*.{js,css}\" \"../backend/package.json\" \"package.json\" \"../.prettierrc.json\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "http-proxy-middleware": "^2.0.6",
    "prettier": "^3.9.10"
  }
}
